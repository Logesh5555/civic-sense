# ==============================================================
# CivicTrack — Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================

# 1. Global / Cloud Database Connection (MongoDB Atlas):
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/civictrack?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/civictrack?retryWrites=true&w=majority

# Or for local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/civictrack

# 2. Server Port & Environment:
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 3. Security (JWT Authentication):
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# 4. Storage & Cloudinary Configuration:
# Set to 'cloudinary' (auto-enabled when credentials are provided) or 'local'
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=civictrack/complaints

# Max upload size per image in megabytes (default: 5)
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads
