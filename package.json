{
  "name": "civic-sense-root",
  "private": true,
  "workspaces": [
    "civictrack",
    "civictrack/client",
    "civictrack/server"
  ],
  "scripts": {
    "build": "npm --prefix civictrack run build",
    "build:client": "npm --prefix civictrack/client run build",
    "dev": "npm --prefix civictrack run dev",
    "dev:server": "npm --prefix civictrack run dev:server",
    "dev:server:memory": "npm --prefix civictrack run dev:server:memory",
    "dev:client": "npm --prefix civictrack run dev:client",
    "seed": "npm --prefix civictrack run seed",
    "start": "npm --prefix civictrack start"
  },
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^2.4.0",
    "zod": "^3.24.1"
  }
}
